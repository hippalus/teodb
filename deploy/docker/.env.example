# TeoDB Docker Compose secrets / credentials.
#
# Copy to `.env` (which is gitignored) and edit. docker compose auto-loads
# `.env` from the directory you run it in:
#
#   cd deploy/docker && cp .env.example .env && $EDITOR .env
#   docker compose -f docker-compose.production.yaml up --build
#
# The defaults below match the historical dev values so the stack still comes up
# unconfigured — CHANGE THEM before exposing the stack anywhere.

# --- Object store (RustFS root creds, also used as S3 creds by TeoDB) ---
TEODB_S3_ACCESS_KEY=teodbadmin
TEODB_S3_SECRET_KEY=teodbadmin123
TEODB_S3_REGION=us-east-1

# --- Iceberg catalog database (Postgres) ---
TEODB_PG_DB=iceberg_catalog
TEODB_PG_USER=iceberg
TEODB_PG_PASSWORD=iceberg

# --- Stable multi-writer identity (shared by every data node) ---
# Generate once per logical cluster (for example, `uuidgen`) and never rotate it.
TEODB_CLUSTER_ID=11111111-1111-1111-1111-111111111111

# --- TeoDB admin bearer token (guards admin endpoints + /metrics) ---
# Empty leaves them unauthenticated (a startup warning is logged).
TEODB_ADMIN_TOKEN=
